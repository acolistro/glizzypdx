{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* TS6 changed the default for this option: omitting "types" used to
       mean "auto-include every @types/* package," but as of TS6 it now
       means "include nothing" unless explicitly listed here. geojson is
       consumed as an ambient global (GeoJSON.Feature, etc., via its
       `export as namespace GeoJSON` declaration) in VendorMapView.tsx —
       without this entry, `pnpm tsc --build` can't find that namespace
       even though the package is correctly installed. Add any future
       package here too if it's meant to be used as a bare global type
       rather than imported explicitly. */
    "types": ["geojson"],

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/test/integration", "src/styles/tokens.test.ts"]
}